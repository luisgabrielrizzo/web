---
// Lógica de Astro: Busca y ordena los artículos del blog por fecha
const posts = Object.values(import.meta.glob('./articulos/*.md', { eager: true }));
const publicaciones = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Luis Gabriel Rizzo | Contador Público</title>
    <meta name="description" content="CV profesional de Luis Gabriel Rizzo, Contador Público y Auditor Externo radicado en Salta." />
    <link rel="icon" type="image/jpeg" href="/fotoperfil.jpg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        :root { 
            --azul-corporativo: #0F172A; 
            --azul-claro: #0891B2;       
            --celeste-acento: #06B6D4;   
            --dorado: #f59e0b;           
            --verde-exito: #10b981;      
            --gris-fondo: #F8FAFC;       
            --texto-principal: #334155;  
            --fuente-titulos: 'Inter', sans-serif;
            --fuente-textos: 'Roboto', sans-serif;
        }
        
        /* MICRO-DETALLES VISUALES FINTECH */
        ::-webkit-scrollbar { width: 12px; }
        ::-webkit-scrollbar-track { background: var(--gris-fondo); }
        ::-webkit-scrollbar-thumb { background: var(--azul-claro); border-radius: 10px; border: 3px solid var(--gris-fondo); }
        ::-webkit-scrollbar-thumb:hover { background: var(--celeste-acento); }
        ::selection { background: var(--celeste-acento); color: #ffffff; }
        ::-moz-selection { background: var(--celeste-acento); color: #ffffff; }

        html { scroll-behavior: smooth; }
        body { font-family: var(--fuente-textos); line-height: 1.6; margin: 0; padding: 0; color: var(--texto-principal); background-color: var(--gris-fondo); overflow-x: hidden; }
        h1, h2, h3, h4 { font-family: var(--fuente-titulos); }
        
        /* CABECERA SEGURA Y NODOS */
        header { 
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(8, 145, 178, 0.85)), url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop') no-repeat center center/cover;
            color: #fff; padding: 140px 20px 100px; text-align: center; position: relative; overflow: hidden;
        }
        
        #particles-js { position: absolute; width: 100%; height: 100%; top: 0; left: 0; z-index: 0; }
        .header-content { position: relative; z-index: 1; }
        
        .foto-perfil { width: 190px; height: 190px; border-radius: 50%; object-fit: cover; border: 4px solid var(--celeste-acento); box-shadow: 0 10px 30px rgba(0,0,0,0.4); margin-bottom: 25px; transition: transform 0.4s ease, box-shadow 0.4s ease; }
        .foto-perfil:hover { transform: scale(1.08) translateY(-5px); box-shadow: 0 15px 40px rgba(6, 182, 212, 0.4); }
        header h1 { margin: 0; font-size: 3.2em; letter-spacing: 1px; font-weight: 800; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
        
        .typing-container { margin-top: 15px; font-size: 1.5em; color: #bae6fd; font-weight: 300; min-height: 35px; }
        .cursor { display: inline-block; width: 3px; height: 1.2em; background-color: var(--dorado); vertical-align: middle; animation: blink 0.8s infinite; margin-left: 5px; }
        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
        
        /* MENU GLASSMORPHISM */
        nav { 
            background: rgba(15, 23, 42, 0.75) !important; 
            backdrop-filter: blur(15px) saturate(180%) !important; 
            -webkit-backdrop-filter: blur(15px) saturate(180%) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            padding: 15px; text-align: center; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }
        nav a { color: white; margin: 0 20px; text-decoration: none; font-weight: 500; font-size: 1.1em; transition: all 0.3s; padding: 5px 10px; border-radius: 5px; }
        nav a:hover { color: var(--dorado); background: rgba(255,255,255,0.1); transform: translateY(-2px); }
        
        .container { max-width: 1000px; margin: 60px auto; padding: 40px; background: #fff; border-radius: 12px; box-shadow: 0 10px 30px rgba(14, 165, 233, 0.08); border-top: 5px solid transparent; transition: border-color 0.3s; }
        .container:hover { border-top-color: var(--celeste-acento); }
        .reveal { opacity: 0; transform: translateY(40px); transition: all 0.8s cubic-bezier(0.5, 0, 0, 1); }
        .reveal.active { opacity: 1; transform: translateY(0); }
        h2 { color: var(--azul-corporativo); border-bottom: 2px solid var(--celeste-acento); padding-bottom: 15px; font-size: 2em; margin-bottom: 30px; display: inline-block; }
        h2 i { color: var(--dorado); margin-right: 10px; }

        .perfil-flex { display: flex; gap: 40px; align-items: center; }
        .perfil-texto { flex: 1; }
        .perfil-imagen-container { flex: 1; overflow: hidden; border-radius: 12px; box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
        .perfil-imagen-container img { width: 100%; height: auto; display: block; transition: transform 0.5s ease; }
        .perfil-imagen-container:hover img { transform: scale(1.05); }
        
        .btn-secundario { display: inline-flex; align-items: center; padding: 10px 20px; background-color: #0077b5; color: white; text-decoration: none; border-radius: 50px; font-weight: bold; margin-top: 15px; transition: all 0.3s; }
        .btn-secundario:hover { background-color: #005a8a; transform: translateY(-3px); box-shadow: 0 8px 15px rgba(0, 119, 181, 0.3); }
        a[href="#contacto"]:hover, .btn-calc:hover, .btn-perfil:hover { box-shadow: 0 0 20px rgba(6, 182, 212, 0.6) !important; }
        
        .grid-perfil { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
        .card-perfil { background: #fff; padding: 30px; border-radius: 10px; border: 1px solid #e0f2fe; border-left: 4px solid var(--azul-claro); position: relative; z-index: 1; transform-style: preserve-3d; transition: box-shadow 0.4s ease, border-color 0.4s ease; }
        .card-perfil:hover { box-shadow: 0 25px 45px rgba(37, 99, 235, 0.15); border-left-color: var(--dorado); z-index: 2; }
        .card-perfil h3 { color: var(--azul-claro); margin-top: 0; font-size: 1.3em; transform: translateZ(30px); }
        .card-perfil p { transform: translateZ(20px); }
        .badge-sistema { display: inline-block; background: #f0f9ff; color: var(--azul-corporativo); padding: 8px 15px; border-radius: 6px; font-size: 0.9em; font-weight: 600; margin-top: 8px; margin-right: 5px; border: 1px solid #bae6fd; transition: all 0.3s; cursor: default; transform: translateZ(40px); }
        .badge-sistema:hover { background: var(--azul-corporativo); color: white; transform: translateZ(50px) translateY(-3px); box-shadow: 0 5px 10px rgba(30, 58, 138, 0.2); }
        .badge-actual { display: inline-block; background: var(--verde-exito); color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.85em; font-weight: bold; margin-bottom: 15px; box-shadow: 0 4px 6px rgba(16, 185, 129, 0.2); animation: pulse 2s infinite; transform: translateZ(35px); }
        @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); } 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); } }
        
        .grid-blog { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 30px; }
        .blog-card { background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #e0f2fe; display: flex; flex-direction: column; transform-style: preserve-3d; transition: box-shadow 0.4s ease; }
        .blog-card:hover { box-shadow: 0 30px 60px rgba(37, 99, 235, 0.2); }
        .blog-img { width: 100%; height: 220px; object-fit: cover; transform: translateZ(10px); }
        .blog-content { padding: 25px; flex-grow: 1; display: flex; flex-direction: column; background: white; position: relative; z-index: 2; transform: translateZ(30px); }
        .blog-fecha { color: var(--celeste-acento); font-size: 0.85em; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
        .blog-content h3 { color: var(--azul-corporativo); margin: 10px 0; font-size: 1.4em; transition: color 0.3s; }
        .blog-card:hover .blog-content h3 { color: var(--azul-claro); }
        .btn-leer { display: inline-flex; align-items: center; color: var(--azul-claro); font-weight: bold; text-decoration: none; margin-top: auto; padding-top: 15px; font-size: 1.05em; transition: color 0.3s; transform: translateZ(40px); }
        .btn-leer:hover { color: var(--dorado); }
        
        .contacto-seccion { text-align: center; padding: 30px 0 10px; }
        .botonera-contacto { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-top: 35px; }
        .btn-perfil { display: inline-flex; align-items: center; justify-content: center; padding: 15px 35px; text-decoration: none; font-weight: bold; font-size: 1.05em; border-radius: 50px; box-shadow: 0 8px 20px rgba(0,0,0,0.15); transition: all 0.3s ease; color: white; position: relative; overflow: hidden; }
        .btn-perfil::after { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent); transition: left 0.5s ease; }
        .btn-perfil:hover::after { left: 100%; }
        .btn-perfil i { margin-right: 10px; font-size: 1.2em; }
        .btn-perfil:hover { transform: translateY(-5px); box-shadow: 0 15px 25px rgba(0,0,0,0.2); }
        .btn-linkedin { background: linear-gradient(135deg, #0077b5, #005a8a); }
        .btn-cv { background: linear-gradient(135deg, #f43f5e, #be123c); }

        footer { text-align: center; padding: 30px 20px; background-color: #1e293b; color: #94a3b8; font-size: 0.9em; border-top: 3px solid var(--dorado); margin-top: 80px; }
        footer p { margin: 0; }
        footer span { color: var(--dorado); font-weight: 600; }

        .chat-container { position: fixed; bottom: 30px; right: 30px; z-index: 2000; font-family: 'Segoe UI', Tahoma, sans-serif; }
        .chat-btn-flotante { background: var(--azul-corporativo); color: white; border: none; width: 60px; height: 60px; border-radius: 50%; font-size: 24px; cursor: pointer; box-shadow: 0 10px 25px rgba(30, 58, 138, 0.4); transition: transform 0.3s; display: flex; align-items: center; justify-content: center; animation: floatChat 3s ease-in-out infinite; }
        .chat-btn-flotante:hover { transform: scale(1.1); background: var(--azul-claro); }
        @keyframes floatChat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

        .chat-window { position: absolute; bottom: 80px; right: 0; width: 350px; background: white; border-radius: 12px; box-shadow: 0 15px 40px rgba(0,0,0,0.2); overflow: hidden; display: flex; flex-direction: column; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); transform-origin: bottom right; border: 1px solid #e0f2fe; }
        .chat-window.oculto { transform: scale(0); opacity: 0; pointer-events: none; }
        .chat-header { background: linear-gradient(135deg, var(--azul-corporativo), var(--azul-claro)); color: white; padding: 15px; display: flex; justify-content: space-between; align-items: center; }
        .chat-header-info { display: flex; align-items: center; gap: 12px; }
        .chat-avatar { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--dorado); object-fit: cover; }
        .chat-header-info div { display: flex; flex-direction: column; line-height: 1.2; }
        .chat-header-info strong { font-size: 1.1em; }
        .chat-header-info span { font-size: 0.75em; color: #bae6fd; display: flex; align-items: center; gap: 4px; margin-top: 3px; }
        .punto-verde { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; display: inline-block; }
        #cerrar-chat { background: none; border: none; color: white; font-size: 1.2em; cursor: pointer; transition: transform 0.2s; }
        #cerrar-chat:hover { transform: scale(1.2); }
        
        .chat-messages { height: 320px; padding: 15px; overflow-y: auto; background: #f8fafc; display: flex; flex-direction: column; gap: 12px; scroll-behavior: smooth; }
        .mensaje { max-width: 85%; padding: 12px 15px; border-radius: 15px; font-size: 0.95em; line-height: 1.4; animation: fadeInChat 0.3s ease forwards; position: relative; }
        .mensaje.bot { background: white; color: var(--texto-principal); align-self: flex-start; border-bottom-left-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
        .mensaje.usuario { background: var(--azul-corporativo); color: white; align-self: flex-end; border-bottom-right-radius: 4px; box-shadow: 0 2px 8px rgba(30,58,138,0.2); }
        
        .chat-input-area { padding: 15px; background: white; border-top: 1px solid #e2e8f0; }
        .chat-opciones { display: flex; flex-direction: column; gap: 8px; }
        .chat-opcion { background: #f0f9ff; color: var(--azul-corporativo); border: 1px solid #bae6fd; padding: 10px 15px; border-radius: 8px; font-size: 0.9em; cursor: pointer; transition: all 0.2s; font-weight: 600; text-align: left; display: flex; justify-content: space-between; align-items: center; }
        .chat-opcion:hover { background: var(--azul-claro); color: white; border-color: var(--azul-claro); transform: translateX(5px); }
        
        .escribiendo { display: flex; gap: 5px; align-items: center; padding: 12px 15px; background: white; border-radius: 15px; border-bottom-left-radius: 4px; align-self: flex-start; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
        .escribiendo span { width: 6px; height: 6px; background: #94a3b8; border-radius: 50%; animation: typing 1.4s infinite ease-in-out both; }
        .escribiendo span:nth-child(1) { animation-delay: -0.32s; }
        .escribiendo span:nth-child(2) { animation-delay: -0.16s; }
        @keyframes typing { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }
        @keyframes fadeInChat { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .cotizaciones-panel { background: white; padding: 25px; border-radius: 12px; border: 1px solid #e0f2fe; box-shadow: 0 10px 25px rgba(30,58,138,0.05); }
        .cotizaciones-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
        .cotizacion-card { background: #f8fafc; border-left: 4px solid var(--dorado); padding: 20px; border-radius: 8px; display: flex; flex-direction: column; justify-content: center; min-height: 110px; transform-style: preserve-3d; transition: box-shadow 0.4s ease; }
        .cotizacion-card:hover { box-shadow: 0 15px 35px rgba(0,0,0,0.1); }
        .cotizacion-tipo { display: block; font-size: 1.1em; font-weight: 700; color: var(--azul-corporativo); letter-spacing: 0.5px; text-align: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-bottom: 10px; transform: translateZ(25px); }
        .cotizacion-valores-container { display: flex; justify-content: space-between; width: 100%; margin: 15px 0 10px; gap: 10px; transform: translateZ(40px); }
        .cotizacion-fecha { display: block; font-size: 0.75em; color: #94a3b8; margin-top: 10px; text-align: center; transform: translateZ(20px);}
        
        /* EFECTO ESQUELETO (SKELETON LOADING) */
        .skeleton-card { background: #e2e8f0; border-radius: 8px; min-height: 110px; position: relative; overflow: hidden; border-left: 4px solid #cbd5e1; }
        .skeleton-card::after { content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent); animation: skeleton-shimmer 1.5s infinite; }
        @keyframes skeleton-shimmer { 100% { left: 100%; } }

        .vencimiento-item { display: flex; align-items: center; justify-content: space-between; padding: 12px 15px; background: #f8fafc; border-left: 4px solid var(--azul-claro); border-radius: 6px; margin-bottom: 10px; transition: transform 0.2s, box-shadow 0.2s; }
        .vencimiento-item:hover { transform: translateX(5px); box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        .vencimiento-item-dia { font-weight: 700; color: var(--azul-corporativo); font-size: 1.05em; }
        .vencimiento-item-titulo { color: #64748b; font-size: 0.9em; }

        .calculadora-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; background: white; padding: 30px; border-radius: 12px; border: 1px solid #e0f2fe; box-shadow: 0 10px 25px rgba(30,58,138,0.05); }
        .calc-controles { display: flex; flex-direction: column; gap: 15px; }
        .input-grupo { display: flex; flex-direction: column; }
        .input-grupo label { font-weight: 600; color: var(--azul-corporativo); font-size: 0.9em; margin-bottom: 5px; }
        .input-grupo input { padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1em; outline: none; transition: border-color 0.3s, box-shadow 0.3s; }
        .input-grupo input:focus { border-color: var(--celeste-acento); box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2); }
        .btn-calc { background: linear-gradient(135deg, var(--dorado), #d97706); color: white; border: none; padding: 15px; border-radius: 8px; font-weight: bold; font-size: 1.1em; cursor: pointer; transition: all 0.3s; margin-top: 10px; display: flex; justify-content: center; align-items: center; gap: 10px; }
        .calc-resultados { background: #f8fafc; border-radius: 12px; padding: 30px; display: flex; flex-direction: column; justify-content: center; border-left: 5px solid var(--verde-exito); }
        .resultado-card h4 { margin: 0; color: #64748b; font-size: 1.1em; font-weight: 600; }
        .monto { font-size: 2.5em; font-weight: 800; color: var(--azul-corporativo); margin: 10px 0 20px; }
        .resultado-desglose { display: flex; flex-direction: column; gap: 10px; border-top: 2px dashed #cbd5e1; padding-top: 20px; }
        .resultado-desglose div { display: flex; justify-content: space-between; font-size: 1.1em; }
        
        @media (max-width: 768px) { .calculadora-grid { grid-template-columns: 1fr; } }
        @media (max-width: 480px) { 
            nav a { display: block; margin: 10px 0; } 
            header { padding: 100px 20px 80px; } 
            header h1 { font-size: 2.2em; } 
            .perfil-flex { flex-direction: column; }
            .chat-window { width: calc(100vw - 40px); right: -10px; bottom: 75px; } 
            .chat-btn-flotante { width: 50px; height: 50px; font-size: 20px; right: 20px; bottom: 20px;}
            .container { padding: 20px; margin: 30px 10px; } 
            .cotizaciones-panel { padding: 15px; margin-bottom: 25px; } 
            .calculadora-grid { padding: 15px; gap: 20px; } 
            .calc-resultados { padding: 15px; } 
            .monto { font-size: 2em; } 
            .card-perfil, .blog-card, .cotizacion-card, .tilt-element { transform-style: flat; }
        }
        
        body.dark-mode { --gris-fondo: #0f172a; --texto-principal: #e2e8f0; --azul-corporativo: #38bdf8; }
        body.dark-mode .container, body.dark-mode .card-perfil, body.dark-mode .blog-card,
        body.dark-mode .blog-content, body.dark-mode .cotizaciones-panel, body.dark-mode .calculadora-grid,
        body.dark-mode .chat-window, body.dark-mode .chat-input-area, body.dark-mode .chat-messages {
            background-color: #1e293b; border-color: #334155; color: #e2e8f0;
        }
        body.dark-mode .cotizacion-card, body.dark-mode .calc-resultados, body.dark-mode .chat-opcion, body.dark-mode .mensaje.bot {
            background-color: #0f172a; border-color: #334155; color: #e2e8f0;
        }
        body.dark-mode .input-grupo input { background-color: #0f172a; color: white; border-color: #334155; }
        body.dark-mode .cotizacion-valor, body.dark-mode .monto, body.dark-mode .input-grupo label { color: #38bdf8; }
        body.dark-mode header a { color: #ffffff !important; }
        body.dark-mode .vencimiento-item { background-color: #0f172a; border-color: #334155; }
        body.dark-mode .vencimiento-item-dia { color: #38bdf8; }
        body.dark-mode .vencimiento-item-titulo { color: #94a3b8; }
        body.dark-mode .cotizacion-tipo { border-color: #334155; color: #38bdf8; }
        body.dark-mode .skeleton-card { background: #1e293b; border-left-color: #334155; }
        body.dark-mode .skeleton-card::after { background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent); }
    </style>
</head>
<body>

<header>
    <div id="particles-js"></div>
    <div id="fecha-en-vivo" style="position: absolute; top: 20px; right: 20px; color: #bae6fd; font-size: 0.85rem; font-weight: 500; font-family: var(--fuente-textos); background: rgba(0,0,0,0.25); padding: 6px 14px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(5px); z-index: 2;">
        Cargando fecha...
    </div>
    <div class="header-content">
        <img src="/fotoperfil.jpg" alt="Luis Gabriel Rizzo" class="foto-perfil" />
        <h1>Luis Gabriel Rizzo</h1>
        <div class="typing-container"><span id="texto-animado"></span><span class="cursor"></span></div>
        <div style="margin-top: 30px; display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
            <a href="#contacto" style="background-color: var(--celeste-acento); color: white; padding: 12px 25px; text-decoration: none; border-radius: 50px; font-weight: bold; font-family: var(--fuente-titulos); transition: transform 0.3s, background-color 0.3s;">
                <i class="fa-regular fa-envelope"></i> Contactar ahora
            </a>
            <a href="https://www.linkedin.com/in/luis-rizzo-cpn/" target="_blank" style="background-color: rgba(255,255,255,0.1); border: 1px solid white; color: white; padding: 12px 25px; text-decoration: none; border-radius: 50px; font-weight: bold; font-family: var(--fuente-titulos); transition: transform 0.3s, background-color 0.3s;" onmouseover="this.style.backgroundColor='rgba(255,255,255,0.2)'" onmouseout="this.style.backgroundColor='rgba(255,255,255,0.1)'">
                <i class="fa-brands fa-linkedin-in"></i> LinkedIn
            </a>
        </div>
