<!-- SCRIPTS INTERACTIVOS -->
<script is:inline>
    // 1. Efecto Máquina de Escribir
    const frases = ["Contador Público Nacional", "Auditoría Externa"];
    let fraseActual = 0;
    let caracterActual = 0;
    let borrando = false;
    const elementoTexto = document.getElementById("texto-animado");

    function escribir() {
        const fraseCompleta = frases[fraseActual];
        
        if (borrando) {
            elementoTexto.textContent = fraseCompleta.substring(0, caracterActual - 1);
            caracterActual--;
        } else {
            elementoTexto.textContent = fraseCompleta.substring(0, caracterActual + 1);
            caracterActual++;
        }

        let velocidad = borrando ? 50 : 100;

        if (!borrando && caracterActual === fraseCompleta.length) {
            velocidad = 2000; 
            borrando = true;
        } else if (borrando && caracterActual === 0) {
            borrando = false;
            fraseActual = (fraseActual + 1) % frases.length;
            velocidad = 500; 
        }

        setTimeout(escribir, velocidad);
    }
    setTimeout(escribir, 1000);

    // 2. Animación al hacer Scroll
    function revelarAlScroll() {
        var revelados = document.querySelectorAll(".reveal");
        for (var i = 0; i < revelados.length; i++) {
            var alturaVentana = window.innerHeight;
            var distanciaElemento = revelados[i].getBoundingClientRect().top;
            if (distanciaElemento < alturaVentana - 100) {
                revelados[i].classList.add("active");
            }
        }
    }
    window.addEventListener("scroll", revelarAlScroll);
    revelarAlScroll();

    // 3. Lógica del Chatbot Simulado
    const btnAbrir = document.getElementById('abrir-chat');
    const btnCerrar = document.getElementById('cerrar-chat');
    const ventanaChat = document.getElementById('chat-window');
    const contenedorMensajes = document.getElementById('chat-messages');
    const cajaOpciones = document.getElementById('caja-opciones');

    btnAbrir.addEventListener('click', () => {
        ventanaChat.classList.remove('oculto');
        btnAbrir.style.transform = 'scale(0)';
    });

    btnCerrar.addEventListener('click', () => {
        ventanaChat.classList.add('oculto');
        btnAbrir.style.transform = 'scale(1)';
    });

    const respuestasBot = {
        experiencia: "Luis se desempeña actualmente como Auditor Externo en el Estudio Simón O. Montes (2026-Presente). Previamente trabajó en Consultora Pluss realizando revisión analítica de extractos financieros. Su fuerte es la verificación de saldos y control normativo.",
        educacion: "Es Contador Público Nacional graduado de la UNSa (Título en trámite) y tiene un 65% de avance en la Licenciatura en Administración de Empresas. Además, cuenta con cursos en liquidación de sueldos.",
        sistemas: "Posee un dominio avanzado en Excel, Google Workspace, herramientas de Inteligencia Artificial aplicadas a la contabilidad y manejo experto del sistema Tango Gestión.",
        contacto: "Por supuesto. El número directo de WhatsApp de Luis es: <strong>+54 9 387 652 4189</strong>.<br><br>También puedes escribirle a <strong>contacto@luisrizzo.com.ar</strong> si prefieres una comunicación más formal. ¿Te ayudo con algo más?"
    };

    const etiquetasBotones = {
        experiencia: "Resumen de Experiencia",
        educacion: "Estudios y Formación",
        sistemas: "Sistemas que maneja",
        contacto: "Solicitar WhatsApp"
    };

    function enviarMensaje(tipo) {
        cajaOpciones.style.display = 'none';

        const msgUsuario = document.createElement('div');
        msgUsuario.className = 'mensaje usuario';
        msgUsuario.textContent = etiquetasBotones[tipo];
        contenedorMensajes.appendChild(msgUsuario);
        contenedorMensajes.scrollTop = contenedorMensajes.scrollHeight;

        const escribiendo = document.createElement('div');
        escribiendo.className = 'escribiendo';
        escribiendo.innerHTML = '<span></span><span></span><span></span>';
        contenedorMensajes.appendChild(escribiendo);
        contenedorMensajes.scrollTop = contenedorMensajes.scrollHeight;

        setTimeout(() => {
            contenedorMensajes.removeChild(escribiendo);

            const msgBot = document.createElement('div');
            msgBot.className = 'mensaje bot';
            msgBot.innerHTML = respuestasBot[tipo];
            contenedorMensajes.appendChild(msgBot);
            contenedorMensajes.scrollTop = contenedorMensajes.scrollHeight;

            cajaOpciones.style.display = 'flex';
        }, 1500);
    }

    // 4. Lógica de la Calculadora Financiera
    function calcularInversion() {
        const p = parseFloat(document.getElementById('capInicial').value);
        const pmt = parseFloat(document.getElementById('aporteMensual').value);
        const r = parseFloat(document.getElementById('tasaAnual').value) / 100;
        const t = parseFloat(document.getElementById('anios').value);
        const n = 12;

        if (isNaN(p) || isNaN(pmt) || isNaN(r) || isNaN(t)) return;

        const tasaMensual = r / n;
        const meses = t * n;
        const capitalFuturo = p * Math.pow(1 + tasaMensual, meses);
        const aportesFuturos = pmt * ((Math.pow(1 + tasaMensual, meses) - 1) / tasaMensual);
        const totalFinal = capitalFuturo + aportesFuturos;
        
        const totalInvertido = p + (pmt * meses);
        const intereses = totalFinal - totalInvertido;

        const formatoMoneda = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

        const calcRes = document.querySelector('.calc-resultados');
        if(!calcRes) return;
        calcRes.style.opacity = '0.5';
        setTimeout(() => {
            document.getElementById('resTotal').innerText = formatoMoneda.format(totalFinal);
            document.getElementById('resInvertido').innerText = formatoMoneda.format(totalInvertido);
            document.getElementById('resIntereses').innerText = formatoMoneda.format(intereses);
            calcRes.style.opacity = '1';
            calcRes.style.transition = 'opacity 0.4s';
        }, 150);
    }
    setTimeout(calcularInversion, 500);

    // 5. Cotizaciones del Dólar (DolarAPI)
    async function obtenerCotizaciones() {
        const panel = document.getElementById('panel-dolares');
        if(!panel) return;
        try {
            const respuesta = await fetch('https://dolarapi.com/v1/dolares');
            const datos = await respuesta.json();
            
            // Filtramos solo Oficial, Blue, MEP y CCL
            const dolaresClave = ['oficial', 'blue', 'mep', 'ccl'];
            const dolaresFiltrados = datos.filter(d => dolaresClave.includes(d.casa));
            
            panel.innerHTML = ''; 
            
            dolaresFiltrados.forEach(dolar => {
                const fecha = new Date(dolar.fechaActualizacion).toLocaleTimeString('es-AR', { hour: '2-digit', minute:'2-digit' });
                const tarjeta = document.createElement('div');
                tarjeta.className = 'cotizacion-card';
                tarjeta.innerHTML = `
                    <span class="cotizacion-tipo">Dólar ${dolar.nombre}</span>
                    <span class="cotizacion-valor">$${dolar.venta}</span>
                    <span class="cotizacion-fecha">Venta • Act: ${fecha}</span>
                `;
                panel.appendChild(tarjeta);
            });
        } catch (error) {
            panel.innerHTML = '<p style="color: red; font-weight: bold; text-align: center;">Servicio de cotización no disponible temporalmente.</p>';
        }
    }
    setTimeout(obtenerCotizaciones, 800);

    // 6. Lógica del Modo Oscuro (Dark Mode)
    const btnDarkMode = document.getElementById('btn-dark-mode');
    const iconDarkMode = btnDarkMode.querySelector('i');
    const cuerpoWeb = document.body;

    // Verificar si el usuario ya tenía el modo oscuro activado en su visita anterior
    if (localStorage.getItem('tema-oscuro') === 'activado') {
        cuerpoWeb.classList.add('dark-mode');
        iconDarkMode.classList.replace('fa-moon', 'fa-sun'); // Cambia la lunita por un sol
    }

    btnDarkMode.addEventListener('click', () => {
        cuerpoWeb.classList.toggle('dark-mode');
        
        if (cuerpoWeb.classList.contains('dark-mode')) {
            localStorage.setItem('tema-oscuro', 'activado'); // Guarda la preferencia
            iconDarkMode.classList.replace('fa-moon', 'fa-sun');
        } else {
            localStorage.setItem('tema-oscuro', 'desactivado');
            iconDarkMode.classList.replace('fa-sun', 'fa-moon');
        }
    });

    // 7. Lógica del Simulador de Préstamos (Sistema Francés)
    function calcularPrestamo() {
        const capital = parseFloat(document.getElementById('montoPrestamo').value);
        const tna = parseFloat(document.getElementById('tasaPrestamo').value);
        const meses = parseInt(document.getElementById('plazoPrestamo').value);

        if (isNaN(capital) || isNaN(tna) || isNaN(meses) || capital <= 0 || meses <= 0) return;

        // Fórmula financiera del Sistema Francés
        const tasaMensual = (tna / 100) / 12;
        let cuota = 0;
        
        if (tasaMensual === 0) {
            cuota = capital / meses;
        } else {
            cuota = capital * (tasaMensual * Math.pow(1 + tasaMensual, meses)) / (Math.pow(1 + tasaMensual, meses) - 1);
        }

        const totalDevolver = cuota * meses;
        const intereses = totalDevolver - capital;

        const formatoMoneda = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

        const calcResPrestamo = document.querySelectorAll('.calc-resultados')[1]; // Selecciona la segunda caja
        if(!calcResPrestamo) return;
        calcResPrestamo.style.opacity = '0.5';
        
        setTimeout(() => {
            document.getElementById('resCuota').innerText = formatoMoneda.format(cuota);
            document.getElementById('resTotalPrestamo').innerText = formatoMoneda.format(totalDevolver);
            document.getElementById('resInteresesPrestamo').innerText = formatoMoneda.format(intereses);
            calcResPrestamo.style.opacity = '1';
            calcResPrestamo.style.transition = 'opacity 0.4s';
        }, 150);
    }
    // Ejecutar al inicio para mostrar los valores por defecto
    setTimeout(calcularPrestamo, 600);
    
    // 8. Fecha en Tiempo Real
    function actualizarFecha() {
        const opciones = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const fechaActual = new Date().toLocaleDateString('es-AR', opciones);
        const fechaCapitalizada = fechaActual.charAt(0).toUpperCase() + fechaActual.slice(1);
        const elementoFecha = document.getElementById('fecha-en-vivo');
        if(elementoFecha) elementoFecha.innerText = fechaCapitalizada;
    }
    actualizarFecha();

    // 9. Lógica del Liquidador Convenio Multilateral
    function calcularCM() {
        const baseTotal = parseFloat(document.getElementById('cmBaseTotal').value);
        const coeficiente = parseFloat(document.getElementById('cmCoeficiente').value);
        const alicuota = parseFloat(document.getElementById('cmAlicuota').value);

        if (isNaN(baseTotal) || isNaN(coeficiente) || isNaN(alicuota)) return;

        // Distribución Art. 2
        const baseAtribuible = baseTotal * coeficiente;
        const impuesto = baseAtribuible * (alicuota / 100);

        const formatoMoneda = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

        // Selecciona la tercera caja de resultados (Inversiones[0], Préstamos[1], CM[2])
        const calcResCM = document.querySelectorAll('.calc-resultados')[2]; 
        if(!calcResCM) return;
        calcResCM.style.opacity = '0.5';
        
        setTimeout(() => {
            document.getElementById('resCmBase').innerText = formatoMoneda.format(baseAtribuible);
            document.getElementById('resCmImpuesto').innerText = formatoMoneda.format(impuesto);
            calcResCM.style.opacity = '1';
            calcResCM.style.transition = 'opacity 0.4s';
        }, 150);
    }
    setTimeout(calcularCM, 700);

    // 10. Función para Desplegar/Plegar el Panel Financiero
    function togglePanelFinanciero() {
        const panel = document.getElementById('contenido-panel-financiero');
        const btn = document.getElementById('btn-toggle-panel');
        
        if (panel.style.display === 'none') {
            // Abrir el panel
            panel.style.display = 'block';
            setTimeout(() => panel.style.opacity = '1', 10); // Efecto suave
            btn.innerHTML = '<i class="fa-solid fa-folder-closed" style="margin-right: 8px;"></i> Cerrar Panel Financiero';
            btn.style.backgroundColor = '#64748b'; // Cambia a gris
        } else {
            // Cerrar el panel
            panel.style.opacity = '0';
            setTimeout(() => panel.style.display = 'none', 500); // Espera que termine el efecto para ocultarlo
            btn.innerHTML = '<i class="fa-solid fa-folder-open" style="margin-right: 8px;"></i> Abrir Panel Financiero';
            btn.style.backgroundColor = 'var(--azul-corporativo)'; // Vuelve a azul
        }
    }
</script>

</body>
</html>