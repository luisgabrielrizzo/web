<!-- LIBRERÍAS DE ANIMACIÓN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>

<script is:inline>
    // 1. SEGURO ANTI-FALLOS DE CARGA
    setTimeout(() => {
        document.querySelectorAll(".reveal").forEach(el => el.classList.add("active"));
    }, 1500);

    // 2. Animación al hacer scroll
    function revelarAlScroll() {
        const revelados = document.querySelectorAll(".reveal");
        const ventana = window.innerHeight;
        revelados.forEach(el => {
            if (el.getBoundingClientRect().top < ventana - 50) {
                el.classList.add("active");
            }
        });
    }
    window.addEventListener("scroll", revelarAlScroll); 
    revelarAlScroll();

    // 3. Partículas con manejo de errores
    try {
        if (typeof particlesJS !== "undefined") {
            particlesJS("particles-js", {
                particles: { 
                    number: { value: 40, density: { enable: true, value_area: 800 } }, 
                    color: { value: "#06B6D4" }, 
                    shape: { type: "circle" }, 
                    opacity: { value: 0.5 }, 
                    size: { value: 3, random: true }, 
                    line_linked: { enable: true, distance: 150, color: "#06B6D4", opacity: 0.4, width: 1 }, 
                    move: { enable: true, speed: 2 } 
                },
                interactivity: { 
                    detect_on: "canvas", 
                    events: { onhover: { enable: true, mode: "grab" }, onclick: { enable: true, mode: "push" }, resize: true }, 
                    modes: { grab: { distance: 140, line_linked: { opacity: 1 } }, push: { particles_nb: 4 } } 
                },
                retina_detect: true
            });
        }
    } catch(error) { 
        console.log("Partículas desactivadas preventivamente."); 
    }

    // 4. Efecto de Escritura
    try {
        const frases = ["Contador Público Nacional", "Auditoría Externa"];
        let fActual = 0, cActual = 0, borrando = false;
        const eTexto = document.getElementById("texto-animado");
        
        function escribir() {
            if(!eTexto) return;
            const f = frases[fActual];
            if (borrando) { 
                eTexto.textContent = f.substring(0, cActual - 1); 
                cActual--; 
            } else { 
                eTexto.textContent = f.substring(0, cActual + 1); 
                cActual++; 
            }
            let vel = borrando ? 50 : 100;
            if (!borrando && cActual === f.length) { 
                vel = 2000; 
                borrando = true; 
            } else if (borrando && cActual === 0) { 
                borrando = false; 
                fActual = (fActual + 1) % frases.length; 
                vel = 500; 
            }
            setTimeout(escribir, vel);
        }
        setTimeout(escribir, 1000);
    } catch(error) {}

    // 5. Fecha Actual
    try {
        const d = new Date().toLocaleDateString('es-AR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        const fEl = document.getElementById('fecha-en-vivo');
        if(fEl) fEl.innerText = d.charAt(0).toUpperCase() + d.slice(1);
    } catch(error) {}

    // 6. Modo Oscuro
    try {
        const btnD = document.getElementById('btn-dark-mode'), iconD = btnD?.querySelector('i');
        if (localStorage.getItem('tema-oscuro') === 'activado') { 
            document.body.classList.add('dark-mode'); 
            if(iconD) iconD.classList.replace('fa-moon', 'fa-sun'); 
        }
        if(btnD) {
            btnD.addEventListener('click', () => {
                document.body.classList.toggle('dark-mode');
                if (document.body.classList.contains('dark-mode')) { 
                    localStorage.setItem('tema-oscuro', 'activado'); 
                    if(iconD) iconD.classList.replace('fa-moon', 'fa-sun'); 
                } else { 
                    localStorage.setItem('tema-oscuro', 'desactivado'); 
                    if(iconD) iconD.classList.replace('fa-sun', 'fa-moon'); 
                }
            });
        }
    } catch(error) {}

    // 7. Lógica del Chatbot
    try {
        const btnAb = document.getElementById('abrir-chat');
        const btnCe = document.getElementById('cerrar-chat');
        const winCh = document.getElementById('chat-window');
        const msgCo = document.getElementById('chat-messages');
        const boxOp = document.getElementById('caja-opciones');
        
        if(btnAb && btnCe) {
            btnAb.addEventListener('click', () => { winCh.classList.remove('oculto'); btnAb.style.transform = 'scale(0)'; });
            btnCe.addEventListener('click', () => { winCh.classList.add('oculto'); btnAb.style.transform = 'scale(1)'; });
        }
        
        const resB = { 
            experiencia: "Luis se desempeña actualmente como Auditor Externo en el Estudio Simón O. Montes (2026-Presente). Previamente trabajó en Consultora Pluss realizando revisión analítica de extractos financieros.", 
            educacion: "Es Contador Público Nacional graduado de la UNSa (Título en trámite) y tiene un 65% de avance en la Licenciatura en Administración de Empresas.", 
            sistemas: "Posee un dominio avanzado en Excel, Google Workspace, herramientas de Inteligencia Artificial aplicadas a la contabilidad y manejo experto del sistema Tango Gestión.", 
            contacto: "El número directo de WhatsApp de Luis es: <strong>+54 9 387 652 4189</strong>.<br><br>También puedes escribirle a <strong>contacto@luisrizzo.com.ar</strong>" 
        };
        const tagB = { 
            experiencia: "Resumen de Experiencia", 
            educacion: "Estudios y Formación", 
            sistemas: "Sistemas que maneja", 
            contacto: "Solicitar WhatsApp" 
        };
        
        window.enviarMensaje = function(t) {
            if(!boxOp || !msgCo) return;
            boxOp.style.display = 'none';
            const mu = document.createElement('div'); mu.className = 'mensaje usuario'; mu.innerHTML = tagB[t];
            msgCo.appendChild(mu); msgCo.scrollTop = msgCo.scrollHeight;
            
            const me = document.createElement('div'); me.className = 'escribiendo'; me.innerHTML = '<span></span><span></span><span></span>';
            msgCo.appendChild(me); msgCo.scrollTop = msgCo.scrollHeight;
            
            setTimeout(() => {
                msgCo.removeChild(me);
                const mb = document.createElement('div'); mb.className = 'mensaje bot'; mb.innerHTML = resB[t];
                msgCo.appendChild(mb); msgCo.scrollTop = msgCo.scrollHeight;
                boxOp.style.display = 'flex';
            }, 1500);
        };
    } catch(error) {}

    // 8. Cuenta Progresiva de Números
    function animarVal(id, valFin) {
        try {
            const obj = document.getElementById(id); if(!obj) return;
            let start = null; const dur = 1200;
            const format = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });
            
            const step = (ts) => {
                if (!start) start = ts;
                const prog = Math.min((ts - start) / dur, 1);
                const ease = 1 - Math.pow(1 - prog, 4);
                obj.innerText = format.format(ease * valFin);
                if (prog < 1) window.requestAnimationFrame(step); 
                else obj.innerText = format.format(valFin);
            };
            window.requestAnimationFrame(step);
        } catch(error){}
    }

    // 9. Calculadoras Financieras
    window.calcularInversion = function() {
        try {
            const p = parseFloat(document.getElementById('capInicial').value);
            const pmt = parseFloat(document.getElementById('aporteMensual').value);
            const r = parseFloat(document.getElementById('tasaAnual').value)/100;
            const t = parseFloat(document.getElementById('anios').value);
            
            if (isNaN(p) || isNaN(pmt) || isNaN(r) || isNaN(t)) return;
            
            const m = t * 12, tm = r / 12;
            const tf = (p * Math.pow(1 + tm, m)) + (pmt * ((Math.pow(1 + tm, m) - 1) / tm));
            const ti = p + (pmt * m), int = tf - ti;
            
            const bx = document.querySelectorAll('.calc-resultados')[0]; 
            if(bx) { 
                bx.style.opacity = '0.5'; 
                setTimeout(() => { 
                    animarVal('resTotal', tf); 
                    animarVal('resInvertido', ti); 
                    animarVal('resIntereses', int); 
                    bx.style.opacity = '1'; bx.style.transition = 'opacity 0.4s'; 
                }, 150); 
            }
        } catch(error){}
    };

    window.calcularPrestamo = function() {
        try {
            const c = parseFloat(document.getElementById('montoPrestamo').value);
            const tna = parseFloat(document.getElementById('tasaPrestamo').value);
            const m = parseInt(document.getElementById('plazoPrestamo').value);
            
            if (isNaN(c) || isNaN(tna) || isNaN(m)) return;
            
            const tm = (tna/100)/12;
            const cu = tm === 0 ? c/m : c*(tm*Math.pow(1+tm,m))/(Math.pow(1+tm,m)-1);
            const td = cu*m, int = td-c;
            
            const bx = document.querySelectorAll('.calc-resultados')[1]; 
            if(bx) { 
                bx.style.opacity = '0.5'; 
                setTimeout(() => { 
                    animarVal('resCuota', cu); 
                    animarVal('resTotalPrestamo', td); 
                    animarVal('resInteresesPrestamo', int); 
                    bx.style.opacity = '1'; bx.style.transition = 'opacity 0.4s'; 
                }, 150); 
            }
        } catch(error){}
    };

    window.calcularCM = function() {
        try {
            const b = parseFloat(document.getElementById('cmBaseTotal').value);
            const c = parseFloat(document.getElementById('cmCoeficiente').value);
            const a = parseFloat(document.getElementById('cmAlicuota').value);
            
            if (isNaN(b) || isNaN(c) || isNaN(a)) return;
            
            const ba = b*c, imp = ba*(a/100);
            
            const bx = document.querySelectorAll('.calc-resultados')[2]; 
            if(bx) { 
                bx.style.opacity = '0.5'; 
                setTimeout(() => { 
                    animarVal('resCmBase', ba); 
                    animarVal('resCmImpuesto', imp); 
                    bx.style.opacity = '1'; bx.style.transition = 'opacity 0.4s'; 
                }, 150); 
            }
        } catch(error){}
    };
    
    // Iniciar calculadoras
    setTimeout(() => { calcularInversion(); calcularPrestamo(); calcularCM(); }, 800);

    window.togglePanelFinanciero = function() {
        try {
            const p = document.getElementById('contenido-panel-financiero');
            const b = document.getElementById('btn-toggle-panel');
            if (p.style.display === 'none') { 
                p.style.display = 'block'; 
                setTimeout(() => p.style.opacity = '1', 10); 
                b.innerHTML = '<i class="fa-solid fa-folder-closed" style="margin-right: 8px;"></i> Cerrar Panel Financiero'; 
                b.style.backgroundColor = '#64748b'; 
            } else { 
                p.style.opacity = '0'; 
                setTimeout(() => p.style.display = 'none', 500); 
                b.innerHTML = '<i class="fa-solid fa-folder-open" style="margin-right: 8px;"></i> Abrir Panel Financiero'; 
                b.style.backgroundColor = 'var(--azul-corporativo)'; 
            }
        } catch(error){}
    };

    // 10. Consulta Dólar API
    async function getCotizaciones() {
        const p = document.getElementById('panel-dolares'); if(!p) return;
        p.innerHTML = '<div class="skeleton-card"></div>'.repeat(4);
        try {
            const res = await fetch('https://dolarapi.com/v1/dolares'); 
            const data = await res.json();
            const flt = data.filter(d => ['oficial', 'blue', 'mep', 'ccl'].includes(d.casa));
            
            p.innerHTML = '';
            flt.forEach(d => {
                const f = new Date(d.fechaActualizacion).toLocaleTimeString('es-AR', { hour: '2-digit', minute:'2-digit' });
                const crd = document.createElement('div'); 
                crd.className = 'cotizacion-card tilt-element';
                crd.innerHTML = `
                    <span class="cotizacion-tipo">Dólar ${d.nombre}</span>
                    <div class="cotizacion-valores-container">
                        <div style="flex: 1; text-align: center; border-right: 1px solid #cbd5e1; padding-right: 5px;">
                            <span style="display: block; font-size: 0.75em; color: #64748b; text-transform: uppercase;">Compra</span>
                            <span class="cotizacion-valor" style="font-size: 1.3em;">$${d.compra}</span>
                        </div>
                        <div style="flex: 1; text-align: center; padding-left: 5px;">
                            <span style="display: block; font-size: 0.75em; color: #64748b; text-transform: uppercase;">Venta</span>
                            <span class="cotizacion-valor" style="font-size: 1.3em; color: var(--celeste-acento);">$${d.venta}</span>
                        </div>
                    </div>
                    <span class="cotizacion-fecha">Act: ${f}</span>
                `;
                p.appendChild(crd);
            });
            
            if (window.innerWidth > 768 && typeof VanillaTilt !== "undefined") { 
                VanillaTilt.init(document.querySelectorAll(".cotizacion-card"), { max: 10, speed: 400, glare: true, "max-glare": 0.2 }); 
            }
        } catch (e) { 
            p.innerHTML = '<p style="color: red; font-weight: bold; text-align: center;">Servicio no disponible temporalmente.</p>'; 
        }
    }
    setTimeout(getCotizaciones, 1000);

    // 11. Vencimientos Automáticos
    function cargarVencimientos() {
        try {
            const hoy = new Date(), m = hoy.getMonth(), a = hoy.getFullYear();
            const vencs = [
                { dia: 15, tit: "Ingresos Brutos (CM03) - SIFERE" }, 
                { dia: 18, tit: "IVA y Cargas Sociales (0-3)" }, 
                { dia: 20, tit: "IVA y Cargas Sociales (4-6)" }, 
                { dia: 22, tit: "IVA y Cargas Sociales (7-9)" }
            ];
            let h = '';
            vencs.forEach(v => {
                let mv = m, av = a; 
                if (hoy.getDate() > v.dia) { 
                    mv++; 
                    if (mv > 11) { mv = 0; av++; } 
                }
                const fv = new Date(av, mv, v.dia);
                const diff = Math.ceil(Math.abs(fv - hoy) / (1000 * 60 * 60 * 24));
                
                let bg = `<span style="background: var(--celeste-acento); color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.75em; font-weight: bold;">En ${diff} días</span>`;
                if (diff === 0) bg = `<span style="background: #ef4444; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.75em; font-weight: bold;">¡VENCE HOY!</span>`;
                else if (diff <= 5) bg = `<span style="background: #f59e0b; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.75em; font-weight: bold;">Faltan ${diff}d</span>`;
                
                h += `<div class="vencimiento-item"><div><div class="vencimiento-item-dia">${v.dia} de ${fv.toLocaleDateString('es-AR', { month: 'short' }).toUpperCase()}</div><div class="vencimiento-item-titulo">${v.tit}</div></div><div>${bg}</div></div>`;
            });
            const p = document.getElementById('lista-vencimientos'); 
            if(p) p.innerHTML = h;
        } catch(error){}
    }
    setTimeout(cargarVencimientos, 1100);

    // 12. Vanilla Tilt General
    try {
        if (window.innerWidth > 768 && typeof VanillaTilt !== "undefined") { 
            VanillaTilt.init(document.querySelectorAll(".tilt-element"), { max: 10, speed: 400, glare: true, "max-glare": 0.2, scale: 1.02 }); 
        }
    } catch(e) {}

    // 13. MENÚ INTELIGENTE (Ocultar al bajar, mostrar al subir)
    try {
        let ultimoScroll = window.pageYOffset || document.documentElement.scrollTop;
        const menuNavegacion = document.querySelector('nav');
        if (menuNavegacion) {
            menuNavegacion.style.transition = 'transform 0.4s cubic-bezier(0.3, 1, 0.3, 1)';
            window.addEventListener('scroll', () => {
                const scrollActual = window.pageYOffset || document.documentElement.scrollTop;
                if (scrollActual > ultimoScroll && scrollActual > 150) {
                    menuNavegacion.style.transform = 'translateY(-100%)';
                } else {
                    menuNavegacion.style.transform = 'translateY(0)';
                }
                ultimoScroll = scrollActual <= 0 ? 0 : scrollActual;
            });
        }
    } catch(e) {}
</script>
</body>
</html>