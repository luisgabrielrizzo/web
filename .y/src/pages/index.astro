---
// Lógica de Astro: Busca y ordena los artículos del blog por fecha
const posts = await Astro.glob('/src/pages/articulos/*.md');
const publicaciones = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luis Rizzo | Contador Público</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --azul-corporativo: #0d233a; --azul-claro: #1d3557; --dorado: #bfa15f; --gris-fondo: #f8f9fa; }
        html { scroll-behavior: smooth; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; margin: 0; padding: 0; color: #333; background-color: var(--gris-fondo); }
        
        header { 
            background: linear-gradient(rgba(13, 35, 58, 0.85), rgba(13, 35, 58, 0.90)), url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop') no-repeat center center/cover;
            color: #fff; padding: 120px 20px 80px; text-align: center; position: relative;
        }
        
        .foto-perfil { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; border: 4px solid var(--dorado); box-shadow: 0 10px 25px rgba(0,0,0,0.3); margin-bottom: 20px; transition: transform 0.3s; }
        .foto-perfil:hover { transform: scale(1.05); }
        
        header h1 { margin: 0; font-size: 3em; letter-spacing: 1px; font-weight: 700; }
        header p { margin: 10px 0 0; font-size: 1.4em; color: #cbd5e1; font-weight: 300; }
        
        nav { 
            background: rgba(13, 35, 58, 0.95); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
            padding: 15px; text-align: center; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 15px rgba(0,0,0,0.1); 
        }
        nav a { color: white; margin: 0 20px; text-decoration: none; font-weight: 500; font-size: 1.1em; transition: color 0.3s; }
        nav a:hover { color: var(--dorado); }
        
        .container { max-width: 1000px; margin: 60px auto; padding: 40px; background: #fff; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); opacity: 0; transform: translateY(20px); animation: fadeIn 0.8s forwards; }
        @keyframes fadeIn { to { opacity: 1; transform: translateY(0); } }
        
        h2 { color: var(--azul-corporativo); border-bottom: 2px solid var(--dorado); padding-bottom: 15px; font-size: 2em; margin-bottom: 30px; }
        h2 i { color: var(--dorado); margin-right: 10px; }
        
        .grid-perfil { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
        .card-perfil { background: #fff; padding: 30px; border-radius: 8px; border: 1px solid #e2e8f0; border-top: 4px solid var(--azul-claro); transition: transform 0.3s, box-shadow 0.3s; position: relative; }
        .card-perfil:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
        .card-perfil h3 { color: var(--azul-claro); margin-top: 0; font-size: 1.3em; }
        
        .badge-sistema { display: inline-block; background: #f1f5f9; color: #0d233a; padding: 6px 12px; border-radius: 4px; font-size: 0.9em; font-weight: 600; margin-top: 8px; margin-right: 5px; border: 1px solid #cbd5e1; }
        .badge-actual { display: inline-block; background: #10b981; color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.85em; font-weight: bold; margin-bottom: 15px; box-shadow: 0 4px 6px rgba(16, 185, 129, 0.2); }
        
        .grid-blog { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 30px; }
        .blog-card { background: #fff; border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; transition: transform 0.3s, box-shadow 0.3s; display: flex; flex-direction: column;}
        .blog-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
        .blog-img { width: 100%; height: 200px; object-fit: cover; }
        .blog-content { padding: 25px; flex-grow: 1; display: flex; flex-direction: column;}
        .blog-fecha { color: #64748b; font-size: 0.85em; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
        .blog-content h3 { color: var(--azul-corporativo); margin: 10px 0; font-size: 1.4em; }
        .btn-leer { display: inline-flex; align-items: center; color: var(--azul-claro); font-weight: bold; text-decoration: none; margin-top: auto; padding-top: 15px; font-size: 1.05em; transition: color 0.3s; }
        .btn-leer i { margin-left: 8px; transition: transform 0.3s; }
        .btn-leer:hover { color: var(--dorado); }
        .btn-leer:hover i { transform: translateX(5px); }
        
        .contacto-seccion { text-align: center; padding: 30px 0 10px; }
        .botonera-contacto { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-top: 35px; }
        .btn-perfil { display: inline-flex; align-items: center; justify-content: center; padding: 15px 30px; text-decoration: none; font-weight: bold; font-size: 1.05em; border-radius: 50px; box-shadow: 0 8px 15px rgba(0,0,0,0.1); transition: all 0.3s; color: white; }
        .btn-perfil i { margin-right: 10px; font-size: 1.2em; }
        .btn-perfil:hover { transform: translateY(-3px); box-shadow: 0 12px 20px rgba(0,0,0,0.15); }
        .btn-wsp { background: linear-gradient(135deg, #25d366, #128c7e); }
        .btn-linkedin { background: linear-gradient(135deg, #0077b5, #005a8a); }
        .btn-cv { background: linear-gradient(135deg, #e04f5f, #c63645); }

        @media (max-width: 768px) { nav a { display: block; margin: 10px 0; } header { padding: 80px 20px 60px; } }
    </style>
</head>
<body>

<header>
    <img src="/fotoperfil.jpg" alt="Luis Rizzo" class="foto-perfil">
    <h1>Luis Rizzo</h1>
    <p>Contador Público</p>
</header>

<nav>
    <a href="#perfil"><i class="fa-regular fa-user"></i> Sobre Mí</a>
    <a href="#experiencia"><i class="fa-solid fa-briefcase"></i> Experiencia</a>
    <a href="#competencias"><i class="fa-solid fa-graduation-cap"></i> Formación</a>
    <a href="#blog"><i class="fa-regular fa-newspaper"></i> Blog</a>
    <a href="#contacto"><i class="fa-regular fa-envelope"></i> Contacto</a>
</nav>

<div class="container" id="perfil" style="animation-delay: 0.1s;">
    <h2><i class="fa-regular fa-id-card"></i> Perfil Profesional</h2>
    <p>Soy Contador Público graduado por la Universidad Nacional de Salta (Título en trámite). Cuento con una sólida trayectoria en auditoría externa en firmas y estudios contables de prestigio, especializándome en la ejecución de procedimientos de control para estados contables, verificación de saldos de balance, control de cuentas corrientes y conciliaciones complejas. Me destaco por mi enfoque metódico para resolver inconsistencias de forma independiente y asegurar la confiabilidad financiera, con el objetivo de continuar mi crecimiento profesional dentro de equipos corporativos y estructuras organizacionales exigentes.</p>
</div>

<div class="container" id="experiencia" style="animation-delay: 0.2s;">
    <h2><i class="fa-solid fa-building-columns"></i> Trayectoria Laboral</h2>
    <div class="grid-perfil">
        <div class="card-perfil">
            <span class="badge-actual">Puesto Actual</span>
            <h3>Auditor Externo</h3>
            <p><strong>Estudio Simón O. Montes y Asociados (2026 - Presente)</strong></p>
            <p>Planificación y ejecución de procedimientos de auditoría externa para estados contables de diversos clientes. Análisis integral de papeles de trabajo, verificación de saldos y control normativo fiscal.</p>
        </div>
        <div class="card-perfil">
            <h3>Auditor Externo</h3>
            <p><strong>Consultora Pluss (2024 - 2026)</strong></p>
            <p>Procedimientos de auditoría externa de balances comerciales. Elaboración de papeles de trabajo, revisión analítica de extractos financieros complejos y resolución autónoma de desvíos en la información contable.</p>
        </div>
        <div class="card-perfil">
            <h3>Becario de Formación</h3>
            <p><strong>Facultad de Ciencias Económicas (UNSa) (2023 - 2024)</strong></p>
            <p>Manejo de datos para informes de gestión, soporte en tareas administrativas, control de expedientes documentales y asistencia directa al cuerpo superior de la institución.</p>
        </div>
        <div class="card-perfil">
            <h3>Auxiliar Administrativo - Contable</h3>
            <p><strong>Empresa Iriarte (2021 - 2022)</strong></p>
            <p>Gestión operativa de cuentas por cobrar y pagar, procesamiento de registros de clientes, archivo documental técnico y conciliaciones bancarias periódicas de soporte impositivo.</p>
        </div>
    </div>
</div>

<div class="container" id="competencias" style="animation-delay: 0.3s;">
    <h2><i class="fa-solid fa-laptop-file"></i> Educación y Aptitudes Técnicas</h2>
    <div class="grid-perfil">
        <div class="card-perfil">
            <h3>Formación Académica</h3>
            <p>• <strong>Contador Público Nacional</strong> (UNSa — Egresado 2025)</p>
            <p>• <strong>Lic. en Administración de Empresas</strong> (UNSa — 65% Aprobado / En curso)</p>
            <p>• Cursos de Liquidación de Sueldos y Desempeño Jurídico-Contable (2024)</p>
        </div>
        <div class="card-perfil">
            <h3>Sistemas e Informática</h3>
            <span class="badge-sistema"><i class="fa-solid fa-file-excel"></i> Excel & Office</span>
            <span class="badge-sistema"><i class="fa-brands fa-google"></i> Google Workspace</span>
            <span class="badge-sistema"><i class="fa-solid fa-robot"></i> Herramientas IA</span>
            <span class="badge-sistema" style="background: var(--dorado); color: white;"><i class="fa-solid fa-server"></i> Tango Gestión</span>
        </div>
    </div>
</div>

<div class="container" id="blog" style="animation-delay: 0.4s;">
    <h2><i class="fa-solid fa-pen-nib"></i> Blog y Actualidad Profesional</h2>
    <div class="grid-blog">
        
        <!-- Bucle automático de Astro que renderiza todas las publicaciones -->
        {publicaciones.length > 0 ? (
            publicaciones.map((post) => (
                <article class="blog-card">
                    <img src={post.frontmatter.image} alt="Portada del artículo" class="blog-img">
                    <div class="blog-content">
                        <div class="blog-fecha">{post.frontmatter.date}</div>
                        <h3>{post.frontmatter.title}</h3>
                        <p>Haz clic en el enlace inferior para leer el desarrollo completo de este análisis profesional.</p>
                        <a href={post.url} class="btn-leer">Leer artículo completo <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </article>
            ))
        ) : (
            <p>Aún no hay artículos publicados en el blog.</p>
        )}

    </div>
</div>

<div class="container" id="contacto" style="animation-delay: 0.5s;">
    <h2><i class="fa-regular fa-handshake"></i> Contacto Profesional</h2>
    <div class="contacto-seccion">
        <p style="font-size: 1.1em; color: #64748b;">Radicado en Salta. Disponible para viajar y participar en proyectos a nivel nacional.</p>
        <p style="font-size: 1.2em;"><strong><i class="fa-regular fa-envelope"></i></strong> contacto@luisrizzo.com.ar</p>
        
        <div class="botonera-contacto">
            <a href="https://wa.me/5493876524189" target="_blank" class="btn-perfil btn-wsp"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
            <a href="https://www.linkedin.com/in/luis-rizzo-cpn/" target="_blank" class="btn-perfil btn-linkedin"><i class="fa-brands fa-linkedin-in"></i> LinkedIn</a>
            <a href="/cv.pdf" download="CV_Luis_Rizzo.pdf" class="btn-perfil btn-cv"><i class="fa-solid fa-file-pdf"></i> Descargar CV</a>
        </div>
    </div>
</div>

</body>
</html>